generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Society {
  id              Int      @id @default(autoincrement())
  societyName     String
  societyEmail    String   @unique
  password        String
  secretaryName   String
  secretaryNumber String
  societyLogo     String
  createdAt       DateTime @default(now())
}
